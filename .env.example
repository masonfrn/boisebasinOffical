# Copy to .env.local and fill in. Everything here must also be set in
# Vercel → Settings → Environment Variables for production.

# --- Lead delivery -----------------------------------------------------------
# Zapier Catch Hook feeding Go High Level. The production hook is hardcoded as a
# fallback in app/api/quote/route.ts; set this only to point somewhere else.
ZAPIER_WEBHOOK_URL=

# --- AI estimate -------------------------------------------------------------
# Anthropic API key. Server-side only — never prefix with NEXT_PUBLIC_.
# Without it, /api/estimate returns 503 and the form quietly skips the estimate.
ANTHROPIC_API_KEY=

# --- Photo uploads -----------------------------------------------------------
# Cloudinary unsigned upload. Both values ship to the browser by design; the
# upload preset is what limits abuse, so configure it as unsigned + image-only
# + size-capped in the Cloudinary dashboard.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
