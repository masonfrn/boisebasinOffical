{
  "mcpServers": {
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--userDataDir",
        "C:/Users/mason/.claude-browser",
        "--viewport",
        "1440x900",
        "--screenshotFormat",
        "jpeg",
        "--screenshotMaxWidth",
        "1400"
      ]
    }
  }
}
